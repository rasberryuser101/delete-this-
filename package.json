{
  "name": "delete-this",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-packs.mjs && node scripts/check-customization.mjs && npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "test:worker": "node scripts/smoke-cloudflare.mjs",
    "lint": "eslint src tests worker vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "npm run build && wrangler dev --local"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.11.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.142.0",
    "ws": "^8.22.0"
  }
}
